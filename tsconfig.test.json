{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "ambient.d.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
